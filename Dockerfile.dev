# Dev image: main image + dev dependencies (pytest, ruff) + agent OpenCode.
# Build the main image first: docker build -t monkey-resonance .  (make build)
FROM monkey-resonance:latest

# Install dev dependencies into the existing venv
COPY requirements-dev.txt /base_app/requirements-dev.txt
RUN uv pip install -r /base_app/requirements-dev.txt && \
    # Install MCP package (version 1.x for FastMCP compatibility)
    uv pip install "mcp<2"

# --- Agent OpenCode ----------------------------------------------------------
# Binaire standalone officiel (aucun Node requis — important pour l'image x Pi).
# ATTENTION : l'image de base finit sur USER mkr, il faut repasser en root pour
# installer dans /usr/local/bin (visible par TOUS les users du container :
# root + mkr, et dans tous les shells, indépendamment du PATH de l'user), puis
# redescendre en mkr à la fin.
# --no-modify-path : le script ne doit pas toucher aux .bashrc du container.
USER root
RUN curl -fsSL https://opencode.ai/v2/install | bash -s -- --no-modify-path \
    && mv /root/.opencode/bin/opencode /usr/local/bin/opencode \
    && rm -rf /root/.opencode \
    && chmod 755 /usr/local/bin/opencode \
    && opencode --version \
    && opencode plugin add opencode-plugin-litellm && rm -rf /root/.opencode \
    && chmod 755 /usr/local/bin/opencode \
    && opencode --version
USER mkr

# Créer un config.json avec les modèles litellm
RUN mkdir -p /home/mkr/.config/opencode && \
    echo '{"providers":{"litellm":{"npm":"@ai-sdk/openai-compatible","name":"LiteLLM","options":{"baseURL":"http://litellm.montalab/v1","apiKey":"{env:LITELLM_API_KEY}"},"models":{"qwen38-35b":{"name":"Qwen3.5-35B"}}}}}' > /home/mkr/.config/opencode/config.json

# Export variables d'environnement pour LiteLLM et venv dans bashrc
RUN echo 'export LITELLM_BASE_URL="http://litellm.montalab/v1/"' >> /home/mkr/.bashrc && \
    echo 'export LITELLM_API_KEY="sk-06a3e028fb8da94ec70e6f91ff7bd68327219729a2d79ad5"' >> /home/mkr/.bashrc && \
    # Ajouter le venv au PYTHONPATH pour que les packages pip soient trouvés
    # avant les modules locaux (ex: mcp.py vs package mcp)
    echo 'export PYTHONPATH="/opt/venv/lib/python3.12/site-packages:$PYTHONPATH"' >> /home/mkr/.bashrc
